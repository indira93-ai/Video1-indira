# =======================================================
# AI Video Synopsis - Environment Variables Configuration
# =======================================================
# When deploying to Vercel, add each of these under:
# Project Settings -> Environment Variables

# --- Supabase Configuration ---
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Groq AI Configuration ---
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Override default Groq LLM model (e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile, llama-3.1-8b-instant)
# If left blank, the app will auto-select the best available active model on your Groq tier
# GROQ_MODEL=openai/gpt-oss-120b

# --- Application URL ---
# In local development: http://localhost:3000
# In Vercel production: https://your-app-name.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
